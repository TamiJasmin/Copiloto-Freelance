{
  "expo": {
    "name": "Lana",
    "slug": "lana",
    "scheme": "lana",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0B",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lana.app"
    },
    "android": {
      "package": "com.lana.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
