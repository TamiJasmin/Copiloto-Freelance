#  PLANTILLA — este archivo SE SUBE A GITHUB.
#  No pongas valores reales acá: copialo a .env (que está ignorado) y
#  completá allá.
#
#  El Access Token de Mercado Pago NO va en ningún .env: Expo sólo lee las
#  variables EXPO_PUBLIC_*, y esas viajan dentro del bundle a la vista de
#  cualquiera. Ese token se carga desde la app, en Mi negocio, y queda
#  guardado del lado del servidor.

# Supabase (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Google OAuth (Supabase -> Authentication -> Providers -> Google)
EXPO_PUBLIC_GOOGLE_REDIRECT=lana://auth/callback

# URL publica de la app. En web se deduce del navegador;
# en iOS/Android hace falta declararla para armar el link del presupuesto.
EXPO_PUBLIC_APP_URL=https://lana.onrender.com
